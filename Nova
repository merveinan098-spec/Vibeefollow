    function recomputeFrontPreview(forcedCss = null) {
      const brightVal = Number(document.getElementById('sl-bright').value);
      const glowVal = Number(document.getElementById('sl-glow').value);
      const lightOn = document.getElementById('sw-pro-light').checked;
      const sharpOn = document.getElementById('sw-pro-sharp').checked;

      let css = forcedCss;
      if (!css) {
        if (!appState.beautyActive && !appState.aiBeautyActive) {
          css = 'none';
        } else {
          const b = lightOn ? (0.9 + (brightVal / 100) * 0.25) : 0.94;
          const c = sharpOn ? 1.12 : 0.98;
          const s = 0.95 + (glowVal / 100) * 0.25;
          css = `brightness(${b.toFixed(2)}) contrast(${c.toFixed(2)}) saturate(${s.toFixed(2)})`;
        }
      }

      document.getElementById('front-after-artwork').style.filter = css;
      document.getElementById('front-video-stream').style.filter = css;
    }

