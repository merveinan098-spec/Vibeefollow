    // Dual Camera Studio & Canvas Fallback Logic
    function initHoloCanvas() {
      const canvas = document.getElementById('rear-holo-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');

      function resizeCanvas() {
        const rect = canvas.parentElement.getBoundingClientRect();
        canvas.width = Math.max(160, Math.floor(rect.width));
        canvas.height = Math.max(160, Math.floor(rect.height));
      }
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);

      function renderHoloFrame() {
        resizeCanvas();
        const w = canvas.width;
        const h = canvas.height;
        const cx = w / 2;
        const cy = h / 2;

        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = 'rgba(5, 7, 12, 0.72)';
        ctx.fillRect(0, 0, w, h);

        ctx.strokeStyle = 'rgba(212, 175, 55, 0.22)';
        ctx.lineWidth = 1;
        for (let i = -4; i <= 4; i++) {
          ctx.beginPath();
          ctx.moveTo(cx + i * 10, cy + 12);
          ctx.lineTo(cx + i * 34, h);
          ctx.stroke();
        }

        holoAngle += 0.018;
        ctx.save();
        ctx.translate(cx, cy - 8);

        ctx.strokeStyle = 'rgba(242, 208, 107, 0.65)';
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.ellipse(0, 0, 42, 16, holoAngle * 0.35, 0, Math.PI * 2);
        ctx.stroke();

        ctx.strokeStyle = 'rgba(56, 189, 248, 0.5)';
        ctx.beginPath();
        ctx.ellipse(0, 0, 56, 22, -holoAngle * 0.25, 0, Math.PI * 2);
        ctx.stroke();

        const bx = Math.cos(holoAngle) * 42;
        const by = Math.sin(holoAngle) * 16;
        ctx.fillStyle = '#F2D06B';
        ctx.beginPath();
        ctx.arc(bx, by, 3, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();
        holoAnimId = requestAnimationFrame(renderHoloFrame);
      }

      if (holoAnimId) cancelAnimationFrame(holoAnimId);
      renderHoloFrame();
    }

    async function initDualCameras() {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) return;
      try {
        const rearStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { ideal: 'environment' } },
          audio: false
        });
        appState.rearStream = rearStream;
        const rVid = document.getElementById('rear-video-stream');
        rVid.srcObject = rearStream;
        rVid.classList.remove('hidden');
        document.getElementById('rear-holo-canvas').classList.add('hidden');
        document.getElementById('rear-source-badge').textContent = 'Arka Canlı';
      } catch (_) {}

      try {
        const frontStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'user' },
          audio: false
        });
        appState.frontStream = frontStream;
        const fVid = document.getElementById('front-video-stream');
        fVid.srcObject = frontStream;
        fVid.classList.remove('hidden');
        document.getElementById('front-after-artwork').classList.add('hidden');
        document.getElementById('front-before-artwork').classList.add('hidden');
      } catch (_) {}
    }

