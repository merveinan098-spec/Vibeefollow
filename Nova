<!DOCTYPE html>
<html lang="tr" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>NOVA — Lüks AI Süper Uygulama, Çift Kamera & Üyelik Önizlemesi</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            luxury: ['Cinzel', 'serif'],
          },
          colors: {
            obsidian: '#050507',
            obsidianPanel: '#0A0B0F',
            obsidianCard: '#0E0F14',
            obsidianSurface: '#151721',
            gold: {
              DEFAULT: '#D4AF37',
              bright: '#F2D06B',
              light: '#F5E6B3',
              dark: '#967414',
            },
            platinum: '#E5E4E2',
          },
          animation: {
            'gold-ring': 'goldRingPulse 2.8s ease-in-out infinite',
          },
          keyframes: {
            goldRingPulse: {
              '0%, 100%': { boxShadow: '0 0 14px rgba(212, 175, 55, 0.35)' },
              '50%': { boxShadow: '0 0 26px rgba(242, 208, 107, 0.72)' },
            }
          }
        }
      }
    };
  </script>

  <style>
    * {
      -webkit-tap-highlight-color: transparent;
      box-sizing: border-box;
    }

    body {
      background-color: #020204;
      color: #F5F5F7;
      font-family: 'Inter', sans-serif;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    .glass-header {
      background: rgba(8, 8, 12, 0.9);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(212, 175, 55, 0.24);
    }

    .glass-gold-pill {
      background: linear-gradient(135deg, rgba(212, 175, 55, 0.16) 0%, rgba(20, 21, 28, 0.94) 100%);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(242, 208, 107, 0.42);
    }

    .gold-gradient-text {
      background: linear-gradient(135deg, #FFF0B8 0%, #F2D06B 50%, #B38919 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .gold-btn {
      background: linear-gradient(135deg, #F6DC88 0%, #D4AF37 55%, #9D7714 100%);
      color: #050507;
      box-shadow: 0 4px 18px rgba(212, 175, 55, 0.34);
    }

    .holo-wireframe {
      background-image:
        linear-gradient(rgba(212, 175, 55, 0.16) 1px, transparent 1px),
        linear-gradient(90deg, rgba(212, 175, 55, 0.16) 1px, transparent 1px),
        radial-gradient(circle at 50% 45%, rgba(56, 189, 248, 0.14), rgba(212, 175, 55, 0.08) 45%, transparent 72%);
      background-size: 22px 22px, 22px 22px, 100% 100%;
    }

    .nova-switch {
      position: relative;
      display: inline-block;
      width: 38px;
      height: 20px;
      flex-shrink: 0;
    }
    .nova-switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    .nova-switch-track {
      position: absolute;
      cursor: pointer;
      inset: 0;
      background-color: #222531;
      border: 1px solid rgba(255, 255, 255, 0.16);
      transition: 0.25s;
      border-radius: 999px;
    }
    .nova-switch-track:before {
      position: absolute;
      content: "";
      height: 14px;
      width: 14px;
      left: 2px;
      bottom: 2px;
      background-color: #D4D4D8;
      transition: 0.25s;
      border-radius: 50%;
    }
    .nova-switch input:checked + .nova-switch-track {
      background: linear-gradient(135deg, #F2D06B, #B48B1E);
      border-color: #F2D06B;
    }
    .nova-switch input:checked + .nova-switch-track:before {
      transform: translateX(18px);
      background-color: #050507;
    }

    input[type="range"].gold-slider {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 4px;
      background: rgba(255, 255, 255, 0.14);
      border-radius: 999px;
      outline: none;
    }
    input[type="range"].gold-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 13px;
      height: 13px;
      border-radius: 50%;
      background: linear-gradient(135deg, #FFF0B8, #D4AF37);
      border: 2px solid #050507;
      cursor: pointer;
      box-shadow: 0 0 8px rgba(242, 208, 107, 0.75);
    }

    .cinematic-bars::before,
    .cinematic-bars::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      height: 9%;
      background: #000000;
      z-index: 25;
      pointer-events: none;
    }
    .cinematic-bars::before { top: 0; }
    .cinematic-bars::after { bottom: 0; }

    @keyframes flashAnim {
      0% { opacity: 0.85; }
      100% { opacity: 0; }
    }
    .flash-active {
      animation: flashAnim 0.35s ease-out forwards;
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center sm:p-3 md:p-5 bg-[#020204]">

  <!-- Main NOVA Mobile Luxury App Shell -->
  <div id="nova-app-shell" class="relative w-full h-[100dvh] sm:w-[432px] sm:h-[885px] sm:rounded-[44px] bg-obsidian sm:border sm:border-gold/35 sm:shadow-[0_0_100px_rgba(212,175,55,0.16)] flex flex-col overflow-hidden">

    <!-- Toast Notifications Stack -->
    <div id="toast-container" class="absolute top-16 left-3 right-3 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- ===================================================================== -->
    <!-- 1. TOP HEADER BAR                                                     -->
    <!-- ===================================================================== -->
    <header class="sticky top-0 z-30 glass-header px-3 pt-2.5 pb-2 flex items-center justify-between gap-1.5 shrink-0">
      <div class="flex items-center gap-2 min-w-0">
        <!-- Gold 'N' Emblem -->
        <button onclick="switchBottomTab('home')" title="NOVA Ana Sayfa"
                class="w-8 h-8 rounded-xl gold-btn flex items-center justify-center font-luxury font-extrabold text-base shrink-0">
          N
        </button>

        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <span class="font-luxury font-bold tracking-[0.2em] text-sm gold-gradient-text">NOVA</span>
            <button onclick="cycleTierBadge()" id="tier-badge-btn"
                    class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded gold-btn border border-gold-bright transition">
              NOVA GOLD (150 TL)
            </button>
          </div>
          <!-- Mood Selector -->
          <button onclick="openMoodModal()" class="flex items-center gap-1 text-[10px] text-zinc-400 hover:text-gold-bright transition">
            <span id="mood-indicator-dot" class="w-1.5 h-1.5 rounded-full bg-gold-bright"></span>
            <span id="mood-indicator-text">Gece Modu</span>
            <i data-lucide="chevron-down" class="w-3 h-3"></i>
          </button>
        </div>
      </div>

      <!-- Right Action Controls: Ekstra + Privacy/Ghost Toggle + Alerts Counter -->
      <div class="flex items-center gap-1.5 shrink-0">
        <button onclick="openExtrasPanel()" class="px-2.5 py-1 rounded-full glass-gold-pill text-[10px] font-bold text-gold-light flex items-center gap-1 hover:border-gold-bright transition">
          <i data-lucide="sparkles" class="w-3 h-3 text-gold-bright"></i> Ekstra
        </button>

        <button id="header-ghost-btn" onclick="toggleGhostPrivacy()" title="Gizlilik / Hayalet Modu"
                class="p-1.5 rounded-full bg-obsidianSurface border border-white/15 text-zinc-300 hover:border-gold-bright transition">
          <i data-lucide="ghost" class="w-3.5 h-3.5"></i>
        </button>

        <button onclick="openAlertsModal()" title="Canlı & Bildirimler"
                class="relative p-1.5 rounded-full bg-obsidianSurface border border-white/15 text-rose-400 hover:border-gold-bright transition">
          <i data-lucide="radio" class="w-3.5 h-3.5"></i>
          <span id="alerts-count-badge" class="absolute -top-1 -right-1 w-3.5 h-3.5 rounded-full bg-amber-500 text-obsidian text-[8px] font-extrabold flex items-center justify-center">
            3
          </span>
        </button>
      </div>
    </header>

    <!-- ===================================================================== -->
    <!-- MAIN SCROLLABLE VIEWPORT                                              -->
    <!-- ===================================================================== -->
    <main id="main-scroll" class="flex-1 overflow-y-auto no-scrollbar pb-20 relative">

      <!-- =================================================================== -->
      <!-- VIEW 1: ANA SAYFA & KEŞFET DISCOVERY VIEW (DEFAULT ON LOAD)        -->
      <!-- =================================================================== -->
      <section id="view-home-discover" class="p-3 space-y-3">

        <!-- Active Logged-In Session Strip (Zero Blocking Modal on Start) -->
        <div class="rounded-2xl bg-obsidianCard border border-gold/25 px-3 py-2 flex items-center justify-between gap-2 text-[10px]">
          <div class="flex items-center gap-2 min-w-0">
            <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
            <span class="text-zinc-300 truncate">
              Oturum açık: <strong id="top-session-name" class="text-white">Elif Kaya</strong> (<span id="top-session-handle" class="text-gold-light">@elif.nova</span>)
            </span>
          </div>
          <button onclick="switchBottomTab('profile')" class="text-gold-bright font-bold whitespace-nowrap hover:underline">
            Profil & Üyelik →
          </button>
        </div>

        <!-- Feed Mode Switcher: 'Akıllı Akış / Tarza Göre Akış / Ruh Hali Modu' -->
        <div class="rounded-2xl bg-obsidianCard border border-white/12 px-2.5 py-2 flex items-center justify-between gap-1 overflow-x-auto no-scrollbar">
          <button onclick="setFeedMode('akilli')" data-fmode="akilli"
                  class="fmode-pill px-2.5 py-1 rounded-full gold-btn text-[10px] font-extrabold whitespace-nowrap transition">
            Akıllı Akış
          </button>
          <span class="text-zinc-600 text-xs">/</span>
          <button onclick="setFeedMode('tarz')" data-fmode="tarz"
                  class="fmode-pill px-2.5 py-1 rounded-full bg-obsidianSurface border border-white/10 text-[10px] font-semibold text-zinc-200 whitespace-nowrap hover:border-gold/40 transition">
            Tarza Göre Akış
          </button>
          <span class="text-zinc-600 text-xs">/</span>
          <button onclick="setFeedMode('ruhhali')" data-fmode="ruhhali"
                  class="fmode-pill px-2.5 py-1 rounded-full bg-obsidianSurface border border-white/10 text-[10px] font-semibold text-zinc-200 whitespace-nowrap hover:border-gold/40 transition">
            Ruh Hali Modu
          </button>
        </div>

        <!-- Gold-Ringed Story Circles: Trend, Canlı, Yeni, Popüler -->
        <div class="grid grid-cols-4 gap-2 pt-0.5 text-center">
          <button onclick="openStoryCircleViewer('Trend')" class="flex flex-col items-center gap-1.5 group">
            <div class="w-16 h-16 rounded-full p-[2.5px] bg-gradient-to-tr from-gold-dark via-gold-bright to-yellow-100 animate-gold-ring">
              <div class="w-full h-full rounded-full bg-obsidian p-[1.5px] overflow-hidden">
                <svg viewBox="0 0 100 100" class="w-full h-full rounded-full">
                  <defs>
                    <linearGradient id="trendRingGrad" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#221D11"/>
                      <stop offset="65%" stop-color="#0B0C10"/>
                      <stop offset="100%" stop-color="#3E300A"/>
                    </linearGradient>
                  </defs>
                  <rect width="100" height="100" fill="url(#trendRingGrad)"/>
                  <rect x="26" y="42" width="12" height="44" rx="2" fill="#2A261B"/>
                  <rect x="42" y="24" width="16" height="62" rx="2" fill="#3B331E"/>
                  <line x1="50" y1="10" x2="50" y2="24" stroke="#F2D06B" stroke-width="2"/>
                  <rect x="62" y="48" width="12" height="38" rx="2" fill="#2A261B"/>
                  <circle cx="28" cy="28" r="2.2" fill="#F2D06B"/>
                  <circle cx="75" cy="24" r="2.5" fill="#FFF0B8"/>
                </svg>
              </div>
            </div>
            <span class="text-[11px] font-semibold text-zinc-100 group-hover:text-gold-bright">Trend</span>
          </button>

          <button onclick="openStoryCircleViewer('Canlı')" class="flex flex-col items-center gap-1.5 group">
            <div class="relative w-16 h-16 rounded-full p-[2.5px] bg-gradient-to-tr from-gold-dark via-gold-bright to-yellow-100 animate-gold-ring">
              <div class="w-full h-full rounded-full bg-obsidian p-[1.5px] overflow-hidden">
                <svg viewBox="0 0 100 100" class="w-full h-full rounded-full">
                  <rect width="100" height="100" fill="#12131A"/>
                  <circle cx="50" cy="44" r="17" fill="#9A7B68"/>
                  <path d="M22 92 C24 68, 76 68, 78 92 Z" fill="#1D202A"/>
                  <path d="M31 44 A19 19 0 0 1 69 44" fill="none" stroke="#D4AF37" stroke-width="3.5"/>
                  <circle cx="50" cy="44" r="24" fill="none" stroke="#F2D06B" stroke-width="1" stroke-dasharray="4 3"/>
                </svg>
              </div>
              <span class="absolute top-0.5 right-0.5 w-3 h-3 rounded-full bg-rose-500 border-2 border-obsidian shadow"></span>
            </div>
            <span class="text-[11px] font-semibold text-zinc-100 group-hover:text-gold-bright">Canlı</span>
          </button>

          <button onclick="openStoryCircleViewer('Yeni')" class="flex flex-col items-center gap-1.5 group">
            <div class="w-16 h-16 rounded-full p-[2.5px] bg-gradient-to-tr from-gold-dark via-gold-bright to-yellow-100 animate-gold-ring">
              <div class="w-full h-full rounded-full bg-obsidian p-[1.5px] overflow-hidden">
                <svg viewBox="0 0 100 100" class="w-full h-full rounded-full">
                  <rect width="100" height="100" fill="#16140F"/>
                  <circle cx="50" cy="43" r="16" fill="#B69276"/>
                  <path d="M24 92 C26 69, 74 69, 76 92 Z" fill="#232018"/>
                  <rect x="35" y="38" width="13" height="8" rx="2" fill="#0B0B0E" stroke="#F2D06B" stroke-width="1.2"/>
                  <rect x="52" y="38" width="13" height="8" rx="2" fill="#0B0B0E" stroke="#F2D06B" stroke-width="1.2"/>
                </svg>
              </div>
            </div>
            <span class="text-[11px] font-semibold text-zinc-100 group-hover:text-gold-bright">Yeni</span>
          </button>

          <button onclick="openStoryCircleViewer('Popüler')" class="flex flex-col items-center gap-1.5 group">
            <div class="w-16 h-16 rounded-full p-[2.5px] bg-gradient-to-tr from-gold-dark via-gold-bright to-yellow-100 animate-gold-ring">
              <div class="w-full h-full rounded-full bg-obsidian p-[1.5px] overflow-hidden">
                <svg viewBox="0 0 100 100" class="w-full h-full rounded-full">
                  <rect width="100" height="100" fill="#181611"/>
                  <circle cx="50" cy="40" r="15" fill="#C49A7E"/>
                  <path d="M22 92 C25 65, 75 65, 78 92 Z" fill="#D4AF37"/>
                  <path d="M36 68 L50 82 L64 68" fill="none" stroke="#050507" stroke-width="2.5"/>
                </svg>
              </div>
            </div>
            <span class="text-[11px] font-semibold text-zinc-100 group-hover:text-gold-bright">Popüler</span>
          </button>
        </div>

        <!-- Category Chips Bar: Tümü, Moda, Seyahat, Yemek, Spor, Müzik, Sanat -->
        <div id="category-chips-container" class="flex gap-1.5 overflow-x-auto no-scrollbar pt-1"></div>

        <!-- 'Keşfet' Heading & 3-Column Grid -->
        <div class="space-y-2.5 pt-1">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-white tracking-tight">Keşfet</h2>
            <span id="discover-active-filter-label" class="text-[10px] font-semibold text-gold-light">Tümü • Akıllı Akış</span>
          </div>

          <div id="discover-3col-grid" class="grid grid-cols-3 gap-2"></div>
        </div>
      </section>

      <!-- =================================================================== -->
      <!-- VIEW 2: SPLIT-SCREEN DUAL CAMERA STUDIO ("KAMERA (+)")              -->
      <!-- =================================================================== -->
      <section id="view-camera-studio" class="hidden p-2.5 space-y-2.5">

        <!-- Studio Top Mode Bar -->
        <div class="rounded-2xl glass-header px-3 py-2 space-y-1.5 border border-gold/25">
          <div class="flex items-center justify-between gap-1.5">
            <div class="flex items-center gap-1.5 shrink-0">
              <div class="w-6 h-6 rounded-lg gold-btn flex items-center justify-center font-luxury font-extrabold text-xs">
                N
              </div>
              <span class="font-luxury font-bold tracking-[0.2em] text-xs gold-gradient-text">NOVA</span>
            </div>

            <div class="flex items-center gap-1 overflow-x-auto no-scrollbar">
              <button onclick="scrollToStudioBlock('beauty-block')" class="px-2 py-1 rounded-full glass-gold-pill text-[9px] font-semibold text-gold-light flex items-center gap-1 whitespace-nowrap hover:border-gold-bright transition">
                <i data-lucide="wand-2" class="w-2.5 h-2.5 text-gold-bright"></i> Güzellik Modu
              </button>
              <button onclick="scrollToStudioBlock('presets-block')" class="px-2 py-1 rounded-full glass-gold-pill text-[9px] font-semibold text-gold-light flex items-center gap-1 whitespace-nowrap hover:border-gold-bright transition">
                <i data-lucide="sliders-horizontal" class="w-2.5 h-2.5 text-gold-bright"></i> Filtre
              </button>
              <button onclick="scrollToStudioBlock('light-block')" class="px-2 py-1 rounded-full glass-gold-pill text-[9px] font-semibold text-gold-light flex items-center gap-1 whitespace-nowrap hover:border-gold-bright transition">
                <i data-lucide="sun" class="w-2.5 h-2.5 text-gold-bright"></i> Işık Ayarları
              </button>
            </div>
          </div>

          <div class="flex items-center justify-between pt-0.5">
            <button onclick="toggleReelsSwitch()" class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-obsidianSurface border border-gold/30 text-[10px] font-semibold text-gold-light">
              <i data-lucide="clapperboard" class="w-3 h-3 text-gold-bright"></i>
              <span>Reels</span>
              <span id="reels-switch-pill" class="w-7 h-3.5 rounded-full bg-gold-bright/90 p-0.5 flex items-center justify-end transition-all">
                <span class="w-2.5 h-2.5 rounded-full bg-obsidian"></span>
              </span>
            </button>

            <div class="text-right leading-tight">
              <div class="text-[9px] font-bold tracking-wider gold-gradient-text uppercase">NOVA AI • DUYGUSAL MOD AKTİF</div>
              <div id="auto-adapt-status" class="text-[8px] text-zinc-400">Işık & Açı Otomatik Uyarlanıyor</div>
            </div>
          </div>
        </div>

        <!-- Split-Screen Dual Camera Stage -->
        <div class="grid grid-cols-12 gap-2">

          <!-- LEFT: ANA KAMERA • 360° HOLO -->
          <div class="col-span-6 rounded-2xl bg-obsidianPanel border border-gold/40 overflow-hidden flex flex-col shadow-[0_0_24px_rgba(212,175,55,0.08)]">
            <div class="px-2 py-1 bg-black/80 border-b border-gold/25 flex items-center justify-between text-[8px] font-bold tracking-wider text-gold-light">
              <span>ANA KAMERA • 360° HOLO</span>
              <span class="px-1 py-0.5 rounded bg-gold/20 text-gold-bright">360°</span>
            </div>

            <div id="rear-camera-stage" class="relative h-52 holo-wireframe overflow-hidden flex items-center justify-center">
              <video id="rear-video-stream" autoplay playsinline muted class="hidden w-full h-full object-cover"></video>
              <canvas id="rear-holo-canvas" class="w-full h-full block"></canvas>

              <div id="rear-scene-visual" class="absolute inset-0 pointer-events-none opacity-45 mix-blend-lighten transition-all duration-300">
                <svg viewBox="0 0 240 240" class="w-full h-full">
                  <rect width="240" height="240" fill="#070912"/>
                  <circle cx="120" cy="110" r="76" fill="none" stroke="#F2D06B" stroke-width="1" stroke-dasharray="5 4" opacity="0.55"/>
                  <ellipse cx="120" cy="175" rx="95" ry="26" fill="none" stroke="#38BDF8" stroke-width="1" opacity="0.45"/>
                  <path d="M25 220 L120 140 L215 220" fill="none" stroke="#D4AF37" stroke-width="1.2" opacity="0.5"/>
                </svg>
              </div>

              <div class="absolute top-2 left-2 z-10 px-1.5 py-0.5 rounded bg-black/75 border border-gold/30 text-[7px] font-mono text-gold-bright">
                <span id="rear-scene-label">360° HOLO GECE</span>
              </div>

              <button onclick="toggleRearSource()" title="Arka Kamera / 360° Holo Geçişi"
                      class="absolute top-2 right-2 z-10 px-1.5 py-0.5 rounded bg-black/75 border border-white/15 text-[7px] font-semibold text-zinc-200 hover:border-gold-bright">
                <span id="rear-source-badge">360° Holo</span>
              </button>

              <div class="absolute bottom-1.5 left-1.5 right-1.5 z-10 flex items-center justify-between gap-1 bg-black/75 border border-gold/25 rounded-xl px-1.5 py-1">
                <span id="rear-smart-scene" class="text-[7px] font-mono text-emerald-300 truncate">
                  AKILLI SAHNE • OTO IŞIK
                </span>
                <button onclick="captureRearEnvironment()" class="px-2 py-0.5 rounded-lg gold-btn text-[8px] font-extrabold shrink-0 active:scale-95">
                  ARKA ÇEK
                </button>
              </div>
            </div>

            <div class="p-1.5 bg-black/75 border-t border-gold/20 space-y-1.5">
              <div class="flex gap-1 overflow-x-auto no-scrollbar">
                <button onclick="setRearEnvironment('360° Holo Gece', 'night', '#38BDF8')"
                        class="rear-env-btn px-2 py-0.5 rounded-lg bg-gold/20 border border-gold/50 text-[8px] font-bold text-gold-bright whitespace-nowrap">
                  Holo Gece
                </button>
                <button onclick="setRearEnvironment('Boğaz & Gün Batımı', 'sunset', '#F59E0B')"
                        class="rear-env-btn px-2 py-0.5 rounded-lg bg-obsidianSurface border border-white/10 text-[8px] text-zinc-300 whitespace-nowrap">
                  Boğaz
                </button>
                <button onclick="setRearEnvironment('Park Yürüyüşü', 'park', '#34D399')"
                        class="rear-env-btn px-2 py-0.5 rounded-lg bg-obsidianSurface border border-white/10 text-[8px] text-zinc-300 whitespace-nowrap">
                  Park
