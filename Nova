      lucide.createIcons();
    }

    function closeAuthModal() { document.getElementById('auth-account-modal').classList.add('hidden'); }

    function switchAuthMode(mode) {
      const isReg = mode === 'register';
      document.getElementById('auth-modal-heading').textContent = isReg ? 'Hesap Oluştur' : 'Giriş Yap';
      document.getElementById('login-account-form').classList.toggle('hidden', isReg);
      document.getElementById('register-account-form').classList.toggle('hidden', !isReg);

      const loginTab = document.getElementById('auth-tab-login');
      const regTab = document.getElementById('auth-tab-register');
      if (isReg) {
        regTab.className = 'py-1.5 rounded-xl gold-btn text-obsidian transition';
        loginTab.className = 'py-1.5 rounded-xl text-zinc-300 hover:text-white transition';
      } else {
        loginTab.className = 'py-1.5 rounded-xl gold-btn text-obsidian transition';
        regTab.className = 'py-1.5 rounded-xl text-zinc-300 hover:text-white transition';
      }
    }

    function handleLoginSubmit(event) {
      event.preventDefault();
      const ident = document.getElementById('login-identifier').value.trim();
      const handle = ident.startsWith('@') ? ident : `@${ident.split('@')[0] || 'nova.uye'}`;
      const name = ident.includes('@') && !ident.startsWith('@')
        ? ident.split('@')[0].replace(/[._]/g, ' ').replace(/\b\w/g, c => c.toUpperCase())
        : handle.replace('@', '').replace(/\b\w/g, c => c.toUpperCase());

      appState.user.loggedIn = true;
      appState.user.displayName = name || 'NOVA Üyesi';
      appState.user.username = handle;
      appState.user.contact = ident;

      syncSessionAndBadgeUI();
      closeAuthModal();
      showToast(`Giriş yapıldı: ${appState.user.displayName}`, 'success');
      renderProfileTabContent();
    }

    function handleRegisterSubmit(event) {
      event.preventDefault();
      const displayName = document.getElementById('reg-display-name').value.trim();
      let username = document.getElementById('reg-username').value.trim();
      const contact = document.getElementById('reg-contact').value.trim();
      if (!username.startsWith('@')) username = `@${username}`;

      appState.user.loggedIn = true;
      appState.user.displayName = displayName;
      appState.user.username = username;
      appState.user.contact = contact;

      syncSessionAndBadgeUI();
      closeAuthModal();
      showToast(`Hesap oluşturuldu: ${displayName}`, 'success');
      renderProfileTabContent();
    }

    function quickDemoLogin(displayName, username, membershipLabel) {
      appState.user.loggedIn = true;
      appState.user.displayName = displayName;
      appState.user.username = username;
      appState.user.contact = `${username.replace('@', '')}@nova.app`;
      appState.user.membership = membershipLabel;

      if (membershipLabel.includes('50 TL')) appState.tierIdx = 1;
      else if (membershipLabel.includes('150 TL')) appState.tierIdx = 2;
      else if (membershipLabel.includes('900 TL')) appState.tierIdx = 3;

      syncSessionAndBadgeUI();
      closeAuthModal();
      showToast(`Aktif hesap: ${displayName} (${membershipLabel})`, 'success');
      renderProfileTabContent();
    }

    function signOutUser() {
      appState.user.loggedIn = false;
      appState.user.displayName = 'Misafir Kullanıcı';
      appState.user.username = '@misafir.nova';
      appState.user.contact = 'Oturum kapalı';
      appState.user.membership = 'Standart (Ücretsiz)';
      appState.tierIdx = 0;

      syncSessionAndBadgeUI();
      showToast('Oturum kapatıldı. İstediğin zaman Giriş Yap veya Hesap Oluştur kullanabilirsin.', 'gold');
      renderProfileTabContent();
    }

    function setBillingCycle(cycle) {
      appState.billingCycle = cycle;
      renderProfileTabContent();
    }

    function getPlanPriceDisplay(plan) {
      if (appState.billingCycle === 'annual') {
        return `${Math.round(plan.monthlyPrice * 12 * 0.8)} TL / yıl`;
      }
      return `${plan.monthlyPrice} TL / ay`;
    }

    function openMembershipCheckout(planId) {
      const plan = paidMembershipPlans.find(p => p.id === planId);
      if (!plan) return;
      appState.pendingCheckoutPlan = plan;

      document.getElementById('checkout-tier-title').textContent = `${plan.name} — ${getPlanPriceDisplay(plan)}`;
      document.getElementById('checkout-period-label').textContent =
        appState.billingCycle === 'annual' ? 'Yıllık Faturalandırma (%20 İndirimli)' : 'Aylık Faturalandırma';
      document.getElementById('checkout-tier-desc').textContent = plan.summary;
      document.getElementById('checkout-price-display').textContent = getPlanPriceDisplay(plan);

      document.getElementById('checkout-benefits-list').innerHTML = plan.benefits.map(b => `
        <div class="flex items-start gap-2 bg-obsidianSurface/80 border border-white/10 rounded-xl p-2">
          <i data-lucide="check-circle-2" class="w-4 h-4 text-gold-bright shrink-0 mt-0.5"></i>
          <span>${b}</span>
        </div>
      `).join('');

      document.getElementById('membership-checkout-modal').classList.remove('hidden');
      lucide.createIcons();
    }

    function closeCheckoutModal() { document.getElementById('membership-checkout-modal').classList.add('hidden'); }

    function confirmMembershipPayment() {
      const plan = appState.pendingCheckoutPlan;
      if (!plan) return;
      if (!appState.user.loggedIn) {
        appState.user.loggedIn = true;
        appState.user.displayName = 'NOVA Üyesi';
        appState.user.username = '@vip.nova';
        appState.user.contact = 'vip@nova.app';
      }
      appState.user.membership = plan.badgeLabel;
      if (plan.id === 'plus') appState.tierIdx = 1;
      else if (plan.id === 'gold') appState.tierIdx = 2;
      else if (plan.id === 'platinum') appState.tierIdx = 3;

      syncSessionAndBadgeUI();
      closeCheckoutModal();
      renderProfileTabContent();
      showToast(`${plan.name} (${plan.monthlyPrice} TL) üyeliği aktifleşti!`, 'success');
    }

