    function setFeedMode(mode) {
      appState.feedMode = mode;
      document.querySelectorAll('.fmode-pill').forEach(pill => {
        if (pill.dataset.fmode === mode) {
          pill.className = 'fmode-pill px-2.5 py-1 rounded-full gold-btn text-[10px] font-extrabold whitespace-nowrap transition';
        } else {
          pill.className = 'fmode-pill px-2.5 py-1 rounded-full bg-obsidianSurface border border-white/10 text-[10px] font-semibold text-zinc-200 whitespace-nowrap hover:border-gold/40 transition';
