    function cycleTierBadge() {
      appState.tierIdx = (appState.tierIdx + 1) % tiers.length;
      const chosen = tiers[appState.tierIdx];
      if (chosen.includes('50 TL')) appState.user.membership = 'Nova Plus (50 TL)';
      else if (chosen.includes('150 TL')) appState.user.membership = 'Nova Gold (150 TL)';
      else if (chosen.includes('900 TL')) appState.user.membership = 'Nova Platinum (900 TL)';
      else appState.user.membership = 'Standart (Ücretsiz)';
      syncSessionAndBadgeUI();
      showToast(`Üyelik seviyesi: ${chosen}`, 'gold');
