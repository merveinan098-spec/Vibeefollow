            </span>
            <span class="absolute bottom-2 left-2 px-1.5 py-0.5 rounded bg-black/75 border border-white/10 text-[9px] text-white font-semibold flex items-center gap-1">
              <span>${item.stat}</span>
              <span class="text-gold-bright">${metricIcon}</span>
