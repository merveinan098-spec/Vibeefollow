            </button>
            <button onclick="switchBottomTab('profile')" class="px-3 py-1.5 rounded-xl bg-obsidianSurface border border-gold/35 text-[11px] font-bold text-gold-light">
              Üyelik Paketleri (50/150/900 TL)
            </button>
          </div>
        </div>
      `;
      lucide.createIcons();
