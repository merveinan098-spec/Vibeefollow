      document.getElementById('sl-glow').value = p.glow;
      document.getElementById('sl-bright').value = p.bright;
      recomputeFrontPreview(p.css);
      showToast(`Ön Ayar uygulandı: ${p.name}`, 'gold');
    }

    function editCustomItem(id) {
      const p = appState.customPresets.find(x => x.id === id);
      if (!p) return;
      p.smooth = Math.min(100, p.smooth + 5);
      p.glow = Math.min(100, p.glow + 5);
      p.name = p.name.endsWith('+') ? p.name : `${p.name} +`;
      renderCustomPresetsStrip();
      renderDrawerPresets();
      showToast(`"${p.name}" yoğunluğu güncellendi.`, 'gold');
