    function showToast(msg, variant = 'gold') {
      const box = document.getElementById('toast-container');
      const el = document.createElement('div');
      let style = 'glass-gold-pill text-gold-light';
      let icon = 'sparkles';
      if (variant === 'success') {
        style = 'bg-emerald-950/95 border border-emerald-500/50 text-emerald-200 backdrop-blur-md';
        icon = 'check-circle-2';
      } else if (variant === 'ghost') {
        style = 'bg-indigo-950/95 border border-indigo-400/50 text-indigo-200 backdrop-blur-md';
        icon = 'ghost';
      }
      el.className = `${style} px-3.5 py-2 rounded-2xl text-[11px] font-medium shadow-2xl flex items-center gap-2 transition-all duration-300`;
      el.innerHTML = `<i data-lucide="${icon}" class="w-4 h-4 shrink-0"></i><span>${msg}</span>`;
      box.appendChild(el);
      lucide.createIcons();
      setTimeout(() => {
        el.style.opacity = '0';
        setTimeout(() => el.remove(), 260);
      }, 2600);
    }

    function syncSessionAndBadgeUI() {
      const badgeBtn = document.getElementById('tier-badge-btn');
      badgeBtn.textContent = tiers[appState.tierIdx] || 'NOVA GOLD (150 TL)';
      document.getElementById('top-session-name').textContent = appState.user.displayName;
      document.getElementById('top-session-handle').textContent = appState.user.username;
