    // Bottom Tabs & Sub-Views
    function switchBottomTab(tab) {
      document.querySelectorAll('.bnav-btn').forEach(btn => {
        if (btn.dataset.bnav === tab) {
          btn.classList.remove('text-zinc-400', 'text-zinc-300');
          btn.classList.add('text-gold-bright');
        } else {
          btn.classList.remove('text-gold-bright');
          btn.classList.add('text-zinc-400');
        }
      });

      const homeSec = document.getElementById('view-home-discover');
      const camSec = document.getElementById('view-camera-studio');
      const subSec = document.getElementById('view-subtab');

      if (tab === 'home') {
        homeSec.classList.remove('hidden');
        camSec.classList.add('hidden');
        subSec.classList.add('hidden');
        return;
      }

      if (tab === 'camera') {
        homeSec.classList.add('hidden');
        camSec.classList.remove('hidden');
        subSec.classList.add('hidden');
        lucide.createIcons();
        return;
      }

      homeSec.classList.add('hidden');
      camSec.classList.add('hidden');
      subSec.classList.remove('hidden');

      if (tab === 'profile') {
        document.getElementById('subtab-kicker').textContent = 'HESAP & ÜYELİK';
        document.getElementById('subtab-title').textContent = 'Profil';
        renderProfileTabContent();
        return;
      }

      const tabInfo = {
        reels: ['DİKEY VİDEO', 'Reels', 'Reels dikey akışı ve 360° Holo kısa klipleri hazır.'],
        moments: ['GERÇEK ANLAR', 'Anlar', 'Günlük anlar, ortak albümler ve altın hikaye kartları.'],
        stream: ['CANLI KEŞFET', 'Akış', 'Akıllı Akış ve canlı odalar aktif.']
      };
      const [kicker, title, desc] = tabInfo[tab] || ['NOVA', 'Keşfet', ''];
      document.getElementById('subtab-kicker').textContent = kicker;
      document.getElementById('subtab-title').textContent = title;
      document.getElementById('subtab-content').innerHTML = `
        <div class="rounded-2xl bg-obsidianCard border border-gold/25 p-3.5 space-y-2.5 text-xs">
          <p class="text-zinc-300">${desc}</p>
          <div class="flex gap-2">
            <button onclick="switchBottomTab('camera')" class="px-3 py-1.5 rounded-xl gold-btn text-[11px] font-bold">
