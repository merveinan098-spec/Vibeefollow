      });
      renderDiscoveryGrid();
      showToast(`Akış modu: ${pillLabel(mode)}`, 'gold');
    }

    function pillLabel(mode) {
      if (mode === 'tarz') return 'Tarza Göre Akış';
      if (mode === 'ruhhali') return 'Ruh Hali Modu';
      return 'Akıllı Akış';
    }

    function renderCategoryChips() {
      document.getElementById('category-chips-container').innerHTML = categoryChips.map(cat => {
        const active = appState.selectedCategory === cat;
        return `
          <button onclick="selectCategory('${cat}')"
                  class="px-3 py-1 rounded-full text-[10px] font-semibold whitespace-nowrap transition ${active ? 'gold-btn' : 'bg-obsidianSurface text-zinc-300 border border-white/15 hover:border-gold/40'}">
            ${cat}
          </button>
        `;
      }).join('');
    }

    function selectCategory(cat) {
      appState.selectedCategory = cat;
      renderCategoryChips();
      renderDiscoveryGrid();
    }

    function renderDiscoveryGrid() {
      const cat = appState.selectedCategory;
      document.getElementById('discover-active-filter-label').textContent = `${cat} • ${pillLabel(appState.feedMode)}`;

      let list = cat === 'Tümü'
        ? [...discoveryItems]
        : discoveryItems.filter(item => item.category === cat);

      if (list.length === 0) list = [...discoveryItems.slice(0, 3)];
      if (appState.feedMode === 'ruhhali') list = [...list].reverse();

      document.getElementById('discover-3col-grid').innerHTML = list.map(item => {
        const badgeIcon = item.format === 'video' ? '▶' : '❐';
        const metricIcon = item.statIcon === 'heart' ? '♥' : '👁';
