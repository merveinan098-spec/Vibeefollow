        id: 'cp-' + Date.now(),
        name,
        smooth: Number(document.getElementById('sl-smooth').value),
        slim: Number(document.getElementById('sl-slim').value),
        glow: Number(document.getElementById('sl-glow').value),
        bright: Number(document.getElementById('sl-bright').value),
